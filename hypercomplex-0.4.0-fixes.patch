+    is_dual = kind in ("dual", "dual_split")
+    full = 1 << (n + 1 if is_dual else n)
+
+    per_entry = 1 + np.dtype(index_dtype(full)).itemsize  # signs + indices
+    if is_dual:
+        per_entry += 1  # eps array
+
+    return full * full * per_entry
+
